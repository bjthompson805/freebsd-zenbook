From 927d156a5ee3eb1c6e98af70055f32f1ed3547f3 Mon Sep 17 00:00:00 2001
From: Brandon Thompson <brandon.joseph.thompson@gmail.com>
Date: Thu, 29 Oct 2026 14:21:15 -0700
Subject: [PATCH 1/8] LinuxKPI: minimal page_pool and skb helpers for mt76

page_pool was all stubs returning NULL, so mt76 had no RX buffers.
Hand out one 1:1 DMA-mapped page per fragment and free it on return,
which matches how skbs already free their pages.  Implement
napi_build_skb() as build_skb(), make skb_mark_for_recycle() a no-op,
and alias system_percpu_wq (Linux v6.17) to system_wq.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../linuxkpi/common/include/linux/skbuff.h    |  9 +-
 .../linuxkpi/common/include/linux/workqueue.h |  3 +
 .../common/include/net/page_pool/helpers.h    | 94 ++++++++++++++++---
 .../common/include/net/page_pool/types.h      |  1 +
 4 files changed, 91 insertions(+), 16 deletions(-)

diff --git a/sys/compat/linuxkpi/common/include/linux/skbuff.h b/sys/compat/linuxkpi/common/include/linux/skbuff.h
index c43d6daff..114ec5011 100644
--- a/sys/compat/linuxkpi/common/include/linux/skbuff.h
+++ b/sys/compat/linuxkpi/common/include/linux/skbuff.h
@@ -1138,8 +1138,7 @@ static inline struct sk_buff *
 napi_build_skb(void *data, size_t len)
 {
 
-	SKB_TODO();
-	return (NULL);
+	return (build_skb(data, len));
 }
 
 static inline uint32_t
@@ -1154,8 +1153,10 @@ static inline void
 skb_mark_for_recycle(struct sk_buff *skb)
 {
 	SKB_TRACE(skb);
-	/* page_pool */
-	SKB_TODO();
+	/*
+	 * Nothing to do: our page_pool does not recycle, and its pages are
+	 * freed like any other skb page.
+	 */
 }
 
 static inline int
diff --git a/sys/compat/linuxkpi/common/include/linux/workqueue.h b/sys/compat/linuxkpi/common/include/linux/workqueue.h
index 66d3981d4..43775a920 100644
--- a/sys/compat/linuxkpi/common/include/linux/workqueue.h
+++ b/sys/compat/linuxkpi/common/include/linux/workqueue.h
@@ -238,6 +238,9 @@ extern struct workqueue_struct *system_unbound_wq;
 extern struct workqueue_struct *system_highpri_wq;
 extern struct workqueue_struct *system_power_efficient_wq;
 
+/* Linux v6.17 renamed system_wq; main has a variable, a macro will do here. */
+#define	system_percpu_wq	system_wq
+
 extern void linux_init_delayed_work(struct delayed_work *, work_func_t);
 extern void linux_work_fn(void *, int);
 extern void linux_delayed_work_fn(void *, int);
diff --git a/sys/compat/linuxkpi/common/include/net/page_pool/helpers.h b/sys/compat/linuxkpi/common/include/net/page_pool/helpers.h
index 3469c39c7..fd14078c6 100644
--- a/sys/compat/linuxkpi/common/include/net/page_pool/helpers.h
+++ b/sys/compat/linuxkpi/common/include/net/page_pool/helpers.h
@@ -9,22 +9,88 @@
 
 #include <linux/kernel.h>	/* pr_debug */
 #include <linux/types.h>
+#include <linux/err.h>
+#include <linux/gfp.h>
+#include <linux/mm.h>
+#include <linux/slab.h>
 #include <linux/dma-mapping.h>
 #include <net/page_pool/types.h>
 
+/*
+ * A minimal page_pool.  It does not pool: every fragment is a page of
+ * its own and pages go back to the VM when they are returned.  This
+ * matches what the skb code does with pages it frees (__free_page() and
+ * page_frag_free()), which knows nothing about pools.
+ *
+ * Because a freed skb never tells us about its pages, a page cannot
+ * carry DMA mapping state we would have to undo.  We therefore only
+ * accept mappings which are 1:1 with the physical address (no IOMMU, no
+ * bounce buffers) and derive the DMA address from the page.  Anything
+ * else fails the allocation rather than leaking mappings.
+ */
+
 static inline struct page_pool *
 page_pool_create(const struct page_pool_params *ppparams)
 {
+	struct page_pool *ppool;
 
-	pr_debug("%s: TODO\n", __func__);
-	return (NULL);
+	/* Fragments are whole pages and freed as order-0 pages by skbs. */
+	if (ppparams->order != 0)
+		return (ERR_PTR(-EINVAL));
+	if ((ppparams->flags & PP_FLAG_DMA_MAP) != 0 && ppparams->dev == NULL)
+		return (ERR_PTR(-EINVAL));
+
+	ppool = kzalloc(sizeof(*ppool), GFP_KERNEL);
+	if (ppool == NULL)
+		return (ERR_PTR(-ENOMEM));
+	ppool->p = *ppparams;
+
+	return (ppool);
 }
 
 static inline void
 page_pool_destroy(struct page_pool *ppool)
 {
 
-	pr_debug("%s: TODO\n", __func__);
+	/* Pages hold no reference to the pool, so in-flight ones are fine. */
+	kfree(ppool);
+}
+
+static inline struct page *
+page_pool_alloc_frag(struct page_pool *ppool, uint32_t *offset,
+    size_t size, gfp_t gfp)
+{
+	struct page *page;
+	dma_addr_t dma;
+
+	if (size > PAGE_SIZE)
+		return (NULL);
+
+	page = alloc_page(gfp);
+	if (page == NULL)
+		return (NULL);
+
+	if ((ppool->p.flags & PP_FLAG_DMA_MAP) != 0) {
+		/* Also syncs for the device, covering PP_FLAG_DMA_SYNC_DEV. */
+		dma = dma_map_page(ppool->p.dev, page, 0, PAGE_SIZE,
+		    ppool->p.dma_dir);
+		if (dma_mapping_error(ppool->p.dev, dma)) {
+			__free_page(page);
+			return (NULL);
+		}
+		if (dma != page_to_phys(page)) {
+			dma_unmap_page(ppool->p.dev, dma, PAGE_SIZE,
+			    ppool->p.dma_dir);
+			__free_page(page);
+			pr_warn_once("%s: DMA address %#jx is not 1:1 with the "
+			    "physical address; not supported\n", __func__,
+			    (uintmax_t)dma);
+			return (NULL);
+		}
+	}
+
+	*offset = 0;
+	return (page);
 }
 
 static inline struct page *
@@ -32,32 +98,36 @@ page_pool_dev_alloc_frag(struct page_pool *ppool, uint32_t *offset,
     size_t size)
 {
 
-	pr_debug("%s: TODO\n", __func__);
-	return (NULL);
+	return (page_pool_alloc_frag(ppool, offset, size,
+	    GFP_ATOMIC | __GFP_NOWARN));
 }
 
 static inline dma_addr_t
 page_pool_get_dma_addr(struct page *page)
 {
 
-	pr_debug("%s: TODO\n", __func__);
-	return (0);
+	/* page_pool_alloc_frag() only hands out 1:1 mapped pages. */
+	return (page_to_phys(page));
 }
 
 static inline enum dma_data_direction
 page_pool_get_dma_dir(const struct page_pool *ppool)
 {
 
-	pr_debug("%s: TODO\n", __func__);
-	return (DMA_BIDIRECTIONAL);
+	return (ppool->p.dma_dir);
 }
 
 static inline void
-page_pool_put_full_page(struct page_pool *ppool, struct page *page,
-    bool allow_direct)
+page_pool_put_full_page(struct page_pool *ppool __unused, struct page *page,
+    bool allow_direct __unused)
 {
 
-	pr_debug("%s: TODO\n", __func__);
+	/*
+	 * Callers find the pool through pp_page_to_nmdesc(), which does not
+	 * point at real state, so ppool must not be used here.  The page
+	 * was 1:1 mapped, so there is no mapping to tear down.
+	 */
+	__free_page(page);
 }
 
 static inline int
diff --git a/sys/compat/linuxkpi/common/include/net/page_pool/types.h b/sys/compat/linuxkpi/common/include/net/page_pool/types.h
index 6747be50b..9bc2a9d0a 100644
--- a/sys/compat/linuxkpi/common/include/net/page_pool/types.h
+++ b/sys/compat/linuxkpi/common/include/net/page_pool/types.h
@@ -27,6 +27,7 @@ struct page_pool_params {
 };
 
 struct page_pool {
+	struct page_pool_params		p;
 };
 
 #define	PP_FLAG_DMA_MAP		BIT(0)
