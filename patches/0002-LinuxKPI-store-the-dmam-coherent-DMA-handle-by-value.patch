From 6188b89587fb51766ce7f52550bb1f1aac44ab4e Mon Sep 17 00:00:00 2001
From: Brandon Thompson <brandon.joseph.thompson@gmail.com>
Date: Thu, 29 Oct 2026 16:19:32 -0700
Subject: [PATCH 2/8] LinuxKPI: store the dmam coherent DMA handle by value

dmam_alloc_coherent() kept a pointer to the caller's dma_handle and
read through it at devres release.  The caller's storage is often gone
by then, so detaching mt7925 panicked in lkpi_dmam_free_coherent().
Main already stores the value; do the same.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/compat/linuxkpi/common/src/linux_pci.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/sys/compat/linuxkpi/common/src/linux_pci.c b/sys/compat/linuxkpi/common/src/linux_pci.c
index c4f0564c7..6e887d0d2 100644
--- a/sys/compat/linuxkpi/common/src/linux_pci.c
+++ b/sys/compat/linuxkpi/common/src/linux_pci.c
@@ -1799,7 +1799,7 @@ linux_dma_alloc_coherent(struct device *dev, size_t size,
 
 struct lkpi_devres_dmam_coherent {
 	size_t size;
-	dma_addr_t *handle;
+	dma_addr_t handle;
 	void *mem;
 };
 
@@ -1809,7 +1809,7 @@ lkpi_dmam_free_coherent(struct device *dev, void *p)
 	struct lkpi_devres_dmam_coherent *dr;
 
 	dr = p;
-	dma_free_coherent(dev, dr->size, dr->mem, *dr->handle);
+	dma_free_coherent(dev, dr->size, dr->mem, dr->handle);
 }
 
 static int
@@ -1835,7 +1835,7 @@ linuxkpi_dmam_free_coherent(struct device *dev, size_t size,
 {
 	struct lkpi_devres_dmam_coherent match = {
 		.size		= size,
-		.handle		= &dma_handle,
+		.handle		= dma_handle,
 		.mem		= addr
 	};
 	int error;
@@ -1862,7 +1862,7 @@ linuxkpi_dmam_alloc_coherent(struct device *dev, size_t size, dma_addr_t *dma_ha
 
 	dr->size = size;
 	dr->mem = linux_dma_alloc_coherent(dev, size, dma_handle, flag);
-	dr->handle = dma_handle;
+	dr->handle = *dma_handle;
 	if (dr->mem == NULL) {
 		lkpi_devres_free(dr);
 		return (NULL);
